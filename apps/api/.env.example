# Copy to .env (cp .env.example .env). The API and the worker both read it.
NODE_ENV=development
PORT=4000

# Matches docker-compose.yml at the repo root (npm run db:up).
# Without Docker: paste your Neon (postgresql://...?sslmode=verify-full) and Upstash (rediss://...) URLs here.
DATABASE_URL=postgresql://postflow:postflow@localhost:5432/postflow
REDIS_URL=redis://localhost:6379
# Put in front of every Redis key, so development and production can share one Redis database.
# Empty = from NODE_ENV: "dev" here, "test" in the tests, "prod" in production. Usually leave it empty.
REDIS_PREFIX=

# The Next.js site (the only origin allowed to call the API).
WEB_ORIGIN=http://localhost:3000

# Signs the login tokens (at least 32 characters, keep it secret). Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Can stay empty in development (a fixed dev value is used). Required in production.
JWT_SECRET=

# Post images and videos (Cloudinary, free plan). Dashboard -> "Go to API Keys" -> copy the
# "API environment variable": cloudinary://<api_key>:<api_secret>@<cloud_name>
# Empty = everything works except uploads. Keep the secret out of git and out of chats.
CLOUDINARY_URL=

# Connecting clients' Facebook pages and Instagram accounts: the Meta app's ID and secret
# (developers.facebook.com -> your app -> App settings -> Basic). Both or neither.
# Empty = connecting is off, and posts can be scheduled without a connected page (development only).
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v24.0

# Encrypts the pages' access tokens in the database: 32 random bytes in base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Can stay empty in development. Required in production. Changing it alone = reconnect every page.
TOKEN_ENCRYPTION_KEY=
# Only while changing the key: the OLD key here, the new one above. The worker re-encrypts the stored
# tokens with the new key; when its log says "0 left on the old one", empty this again.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# AI caption ideas (Google Gemini): a key from aistudio.google.com -> "Get API key". Free tier is enough.
# Empty = the "write a caption" button says it isn't set up.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Sign-ups allowed per hour from one IP (stops fake agencies). Empty = 10 in production, no limit
# in development and tests. 0 = no limit.
SIGNUPS_PER_HOUR=

# true = the API runs the publish worker too (one service on a free host). Default false: run
# `npm run dev:worker` / `npm run worker` as its own process.
RUN_WORKER=false
