// PostFlow database schema.
// Change a model -> `npm run db:migrate -w api -- --name <what-changed>`: creates and applies a migration,
// then postdb:migrate regenerates the client (Prisma 7's migrate dev no longer does that itself).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Agency staff. The client (brand owner) has no account: they only open an approval link (phase 5).
enum Role {
  OWNER // everything: brands, connected accounts, staff, settings
  MANAGER // creates, schedules and publishes posts for every brand
  EDITOR // drafts posts for the brands assigned to them only
}

enum Plan {
  FREE
  PRO
}

// The tenant. Everything else belongs to one agency (agencyId), like a business in BookFlow.
model Agency {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // in URLs: postflow.app/centriva
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  brands  Brand[]
  invites Invite[]
}

model User {
  id              String    @id @default(uuid())
  // Unique across the whole site: the login form asks for email + password only, not the agency.
  email           String    @unique
  name            String
  passwordHash    String // never the password itself
  role            Role      @default(EDITOR)
  // Inside every login token. Adding 1 ends every login of this user at once, on every device
  // ("log out of all devices", a new password): tokens made with an older number are refused.
  sessionVersion  Int       @default(0)
  // When they opened the link in the confirmation email. null = not confirmed yet: everything still
  // works, the dashboard just reminds them.
  emailVerifiedAt DateTime?
  agencyId        String
  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  brands      BrandMember[]
  invitesSent Invite[]
  posts       Post[]
  emailTokens EmailToken[]

  @@index([agencyId])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL // "confirm your email" - 24 hours
  RESET_PASSWORD // "choose a new password" - 1 hour
}

// The secret behind a link sent by email. Like invites: the link holds the secret, the database only
// its SHA-256. A reset link is deleted when used (works once); a confirm link works until it expires.
// A new link of a kind deletes the user's older ones of that kind.
model EmailToken {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
}

// An agency's client (a business whose pages the agency runs).
model Brand {
  id        String   @id @default(uuid())
  name      String
  language  String   @default("ar")
  voice     String? // how the brand talks - given to the AI when it drafts captions (phase 6)
  timezone  String   @default("Asia/Hebron") // the calendar shows times in this zone; the database stores UTC
  // The client approves each post (from a review link) before it can be scheduled (phase 5).
  requiresApproval Boolean @default(false)
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members BrandMember[]
  posts   Post[]
  account     SocialAccount? // its Facebook page (+ Instagram), once the owner connects it (phase 3)
  reviewLinks ReviewLink[] // links the client opens to approve posts (phase 5)

  // Two brands with the same name in one agency: no. The same name in two agencies: fine.
  @@unique([agencyId, name])
  @@index([agencyId])
}

// Which editors work on which brand (many-to-many between User and Brand).
model BrandMember {
  userId    String
  brandId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, brandId]) // the same person can't be assigned to the same brand twice
  @@index([brandId])
}

// A staff invite: the owner makes one, sends the link himself (WhatsApp, Messenger...),
// and the person opens it to make their account. Deleted once accepted, so a link works once.
model Invite {
  id          String   @id @default(uuid())
  email       String // stored lower-case, like User.email
  role        Role // MANAGER or EDITOR - an agency has one owner, never invited
  // SHA-256 of the secret in the link, never the secret itself: someone who reads the database
  // can't use the invites in it (the same idea as passwordHash).
  tokenHash   String   @unique
  expiresAt   DateTime
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  // One open invite per email in an agency: inviting the same email again replaces the old link.
  @@unique([agencyId, email])
}

// Where a post goes out. One post can go to both (the same caption and time).
enum Platform {
  FACEBOOK
  INSTAGRAM
}

// A post's life:  DRAFT -> SCHEDULED -> PUBLISHING -> PUBLISHED, or FAILED if Meta says no.
// The client's approval is its own field (Post.approval): a draft is sent for approval, and a brand
// with requiresApproval can only schedule approved posts.
enum PostStatus {
  DRAFT // being written; anyone on the brand can edit it
  SCHEDULED // has a time and waits for the worker; only an owner or a manager schedules
  PUBLISHING // the worker is sending it to Meta right now - nobody can change it meanwhile
  PUBLISHED // out on the platforms - kept as history, no longer edited
  FAILED // the worker couldn't publish it; can be fixed and scheduled again
}

// One post of one brand. No agencyId of its own: the brand already has it, and every query
// goes through visibleBrands() - the same isolation rule as the brands themselves.
model Post {
  id          String     @id @default(uuid())
  caption     String     @default("") // the text, hashtags included; a draft may start empty
  platforms   Platform[] @default([]) // empty for a draft that hasn't picked yet; a scheduled post needs at least one
  status      PostStatus @default(DRAFT)
  // When to publish, in UTC. The calendar shows it in the brand's time zone (Brand.timezone).
  // A draft may have no time yet; a scheduled post must have one (a CHECK in the migration says so too).
  scheduledAt DateTime?
  publishedAt DateTime? // set by the worker when it's out on every platform
  failReason  String? // why the worker gave up (Meta's own words); cleared when it's scheduled again
  approval     Approval  @default(NONE)
  approvalNote String? // the client's words when asking for changes
  approvalAt   DateTime? // when the client answered
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // Who wrote it. Removing a staff member keeps their posts (the brand's history), just unsigned.
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  media        PostMedia[] // images and videos, in the order they appear (a carousel when more than one)
  publications Publication[] // what happened on each platform

  @@index([brandId, scheduledAt]) // the calendar: one brand's posts between two dates
  @@index([status, scheduledAt]) // the worker (phase 4): scheduled posts whose time has come
  @@index([createdById])
}

enum MediaType {
  IMAGE
  VIDEO
}

// One image or video of a post. The file itself lives on Cloudinary (the browser uploads it there
// directly); this row is what the API checked about it - Meta needs a public URL to fetch at publish time.
model PostMedia {
  id       String    @id @default(uuid())
  postId   String
  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  type     MediaType
  // Cloudinary's name for the file: postflow/<agencyId>/<brandId>/<random>. The API signs the upload
  // for exactly this name, so a file can only ever be attached to a post of the brand it was made for.
  publicId String    @unique
  url      String // https://res.cloudinary.com/... (the original; phase 4 asks Cloudinary for a JPEG for Instagram)
  format   String // jpg, png, webp, heic, mp4, mov
  width    Int
  height   Int
  bytes    Int
  duration Float? // seconds, videos only
  position Int // 0, 1, 2 ... - the order in the post
  createdAt DateTime @default(now())

  @@index([postId, position])
}

// Can we still post with the stored token?
enum AccountStatus {
  OK
  NEEDS_RECONNECT // Meta refused the token (the person who connected it lost access, or changed password)
}

// A brand's Facebook page, and the Instagram professional account linked to that page, if any.
// One per brand. Instagram has no connection of its own: Meta reaches it through the page.
model SocialAccount {
  id                String        @id @default(uuid())
  brandId           String        @unique
  brand             Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pageId            String // Meta's id of the page
  pageName          String
  pagePicture       String? // a URL from Meta; it changes over time, so it's refreshed on each check
  instagramId       String? // the Instagram account's id (instagram_business_account); null = none linked
  instagramUsername String?
  instagramPicture  String?
  // The page's access token, encrypted (meta/token-cipher.ts) - never sent to the browser.
  // A page token got from a long-lived user token doesn't expire, but Meta can still revoke it.
  pageToken         String
  status            AccountStatus @default(OK)
  checkedAt         DateTime      @default(now()) // when Meta last answered for this token
  connectedAt       DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([pageId]) // is this page already connected to another brand of the agency?
}

// The client's answer about one post.
enum Approval {
  NONE // not sent to the client (or changed after they approved it)
  PENDING // sent: waiting for the client
  APPROVED
  CHANGES_REQUESTED // the client wants changes (approvalNote says which)
}

// A link the agency sends a client: <site>/review/<secret>. Whoever has it sees that brand's posts
// waiting for approval, and answers them - no account. Kept as a hash, like invites.
model ReviewLink {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([brandId])
}

enum PublicationStatus {
  PUBLISHED
  FAILED
}

// A post on ONE platform. A post to Facebook and Instagram has two: if Facebook went out and
// Instagram failed, publishing again sends only Instagram - the page never gets the post twice.
model Publication {
  id         String            @id @default(uuid())
  postId     String
  post       Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform   Platform
  status     PublicationStatus
  externalId String? // Meta's id of the published post
  url        String? // where to see it: facebook.com/... or instagram.com/p/...
  error      String? // Meta's reason, when it failed
  attempts   Int               @default(0)
  updatedAt  DateTime          @updatedAt

  @@unique([postId, platform])
}
